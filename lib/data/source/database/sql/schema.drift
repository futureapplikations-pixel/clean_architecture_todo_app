CREATE TABLE IF NOT EXISTS [mementos] (
   [id] INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
   [name] TEXT NOT NULL,
   [photo] TEXT,
   [email] TEXT,
   [phone] TEXT,
   [context] TEXT,
   [job_title] TEXT,
   [company] TEXT,
   [birthday] INTEGER
);

CREATE VIRTUAL TABLE memento_entries USING fts5 (
    name,
    context,
    company,
    content=mementos,
    content_rowid=id
);

CREATE TRIGGER mementos_insert AFTER INSERT ON mementos BEGIN
  INSERT INTO memento_entries(rowid, name, context, company) VALUES (new.id, new.name, new.context, new.company);
END;

CREATE TRIGGER mementos_delete AFTER DELETE ON mementos BEGIN
  INSERT INTO memento_entries(memento_entries, rowid, name, context, company) VALUES ('delete', old.id, old.name, old.context, old.company);
END;

CREATE TRIGGER mementos_update AFTER UPDATE ON mementos BEGIN
  INSERT INTO memento_entries(memento_entries, rowid, name, context, company) VALUES ('delete', new.id, new.name, new.context, new.company);
  INSERT INTO memento_entries(rowid, name, context, company) VALUES (new.id, new.name, new.context, new.company);
END;

_searchMementos: SELECT result.** FROM memento_entries
    INNER JOIN mementos result ON result.id = memento_entries.rowid
    WHERE memento_entries MATCH :query
    ORDER BY rank;
_getMementos: 
    SELECT * FROM [mementos];
_getMementoById:
    SELECT * FROM [mementos]
    WHERE id = :id
    LIMIT 1;
_insertMemento:
    INSERT INTO [mementos] (name, photo, email, phone, context, job_title, company, birthday)
    VALUES (:name, :photo, :email, :phone, :context, :job_title, :company, :birthday);
_updateMemento:
    UPDATE [mementos]
    SET name = :name, photo = :photo, email = :email, phone = :phone, context = :context, job_title = :job_title, company = :company, birthday = :birthday
    WHERE id = :id;
_deleteMemento:
    DELETE FROM [mementos]
    WHERE id = :id;
_deleteAllMementos:
    DELETE FROM [mementos];

CREATE TABLE IF NOT EXISTS [labels] (
   [id] INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
   [name] TEXT NOT NULL,
   [color] INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS [memento_labels] (
   [memento_id] INTEGER NOT NULL,
   [label_id] INTEGER NOT NULL,
   PRIMARY KEY (memento_id, label_id),
   FOREIGN KEY (memento_id) REFERENCES mementos(id),
   FOREIGN KEY (label_id) REFERENCES labels(id)
);

_getLabels:
    SELECT * FROM [labels];
_getLabelById:
    SELECT * FROM [labels]
    WHERE id = :id
    LIMIT 1;
_insertLabel:
    INSERT INTO [labels] (name, color)
    VALUES (:name, :color);
_updateLabel:
    UPDATE [labels]
    SET name = :name, color = :color
    WHERE id = :id;
_deleteLabel:
    DELETE FROM [labels]
    WHERE id = :id;
_getLabelsForMemento:
    SELECT l.* FROM labels l
    INNER JOIN memento_labels ml ON ml.label_id = l.id
    WHERE ml.memento_id = :mementoId;
_addLabelToMemento:
    INSERT INTO memento_labels (memento_id, label_id)
    VALUES (:mementoId, :labelId);
_removeLabelFromMemento:
    DELETE FROM memento_labels
    WHERE memento_id = :mementoId AND label_id = :labelId;

CREATE TABLE IF NOT EXISTS [notes] (
   [id] INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
   [memento_id] INTEGER NOT NULL,
   [content] TEXT NOT NULL,
   [created_at] INTEGER NOT NULL,
   [updated_at] INTEGER,
   [is_favorite] INTEGER NOT NULL DEFAULT 0,
   FOREIGN KEY (memento_id) REFERENCES mementos(id)
);

_getNotes:
    SELECT * FROM [notes];
_getNoteById:
    SELECT * FROM [notes]
    WHERE id = :id
    LIMIT 1;
_getNotesForMemento:
    SELECT * FROM [notes]
    WHERE memento_id = :mementoId
    ORDER BY is_favorite DESC, created_at DESC;
_insertNote:
    INSERT INTO [notes] (memento_id, content, created_at, updated_at, is_favorite)
    VALUES (:mementoId, :content, :createdAt, :updatedAt, :isFavorite);
_updateNote:
    UPDATE [notes]
    SET content = :content, updated_at = :updatedAt, is_favorite = :isFavorite
    WHERE id = :id;
_deleteNote:
    DELETE FROM [notes]
    WHERE id = :id;

CREATE TABLE IF NOT EXISTS [scheduled_messages] (
   [id] INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
   [memento_id] INTEGER NOT NULL,
   [message_type] TEXT NOT NULL,
   [title] TEXT NOT NULL,
   [content] TEXT NOT NULL,
   [scheduled_date_time] INTEGER NOT NULL,
   [is_active] INTEGER NOT NULL DEFAULT 1,
   [created_at] INTEGER NOT NULL,
   [sent_at] INTEGER,
   FOREIGN KEY (memento_id) REFERENCES mementos(id)
);

_getScheduledMessages:
    SELECT * FROM [scheduled_messages]
    ORDER BY scheduled_date_time ASC;
_getScheduledMessageById:
    SELECT * FROM [scheduled_messages]
    WHERE id = :id
    LIMIT 1;
_getScheduledMessagesForMemento:
    SELECT * FROM [scheduled_messages]
    WHERE memento_id = :mementoId
    ORDER BY scheduled_date_time ASC;
_getActiveScheduledMessages:
    SELECT * FROM [scheduled_messages]
    WHERE is_active = 1
    ORDER BY scheduled_date_time ASC;
_getDueScheduledMessages:
    SELECT * FROM [scheduled_messages]
    WHERE scheduled_date_time <= :currentTime
    AND is_active = 1
    AND sent_at IS NULL
    ORDER BY scheduled_date_time ASC;
_insertScheduledMessage:
    INSERT INTO [scheduled_messages] (memento_id, message_type, title, content, scheduled_date_time, is_active, created_at, sent_at)
    VALUES (:mementoId, :messageType, :title, :content, :scheduledDateTime, :isActive, :createdAt, :sentAt);
_updateScheduledMessage:
    UPDATE [scheduled_messages]
    SET memento_id = :mementoId, message_type = :messageType, title = :title, content = :content, scheduled_date_time = :scheduledDateTime, is_active = :isActive, sent_at = :sentAt
    WHERE id = :id;
_deleteScheduledMessage:
    DELETE FROM [scheduled_messages]
    WHERE id = :id;
_markScheduledMessageAsSent:
    UPDATE [scheduled_messages]
    SET sent_at = :sentAt
    WHERE id = :id;

CREATE TABLE IF NOT EXISTS [achievements] (
    [id] TEXT PRIMARY KEY NOT NULL,
    [name] TEXT NOT NULL,
    [description] TEXT NOT NULL,
    [icon] TEXT NOT NULL,
    [category] TEXT NOT NULL,
    [points] INTEGER NOT NULL,
    [unlocked] INTEGER NOT NULL DEFAULT 0,
    [unlocked_date] INTEGER,
    [progress] REAL NOT NULL DEFAULT 0.0,
    [requirement] INTEGER NOT NULL,
    [current_progress] INTEGER NOT NULL DEFAULT 0
);

_getAchievements:
    SELECT * FROM [achievements];
_getAchievementById:
    SELECT * FROM [achievements]
    WHERE id = :id
    LIMIT 1;
_insertAchievement:
    INSERT INTO [achievements] (id, name, description, icon, category, points, unlocked, unlocked_date, progress, requirement, current_progress)
    VALUES (:id, :name, :description, :icon, :category, :points, :unlocked, :unlockedDate, :progress, :requirement, :currentProgress);
_updateAchievement:
    UPDATE [achievements]
    SET name = :name, description = :description, icon = :icon, category = :category, points = :points, unlocked = :unlocked, unlocked_date = :unlockedDate, progress = :progress, requirement = :requirement, current_progress = :currentProgress
    WHERE id = :id;

CREATE TABLE IF NOT EXISTS [quests] (
    [id] TEXT PRIMARY KEY NOT NULL,
    [name] TEXT NOT NULL,
    [description] TEXT NOT NULL,
    [points] INTEGER NOT NULL,
    [completed] INTEGER NOT NULL DEFAULT 0,
    [progress] REAL NOT NULL DEFAULT 0.0,
    [requirement] INTEGER NOT NULL
);

_getQuests:
    SELECT * FROM [quests];
_getQuestById:
    SELECT * FROM [quests]
    WHERE id = :id
    LIMIT 1;
_insertQuest:
    INSERT INTO [quests] (id, name, description, points, completed, progress, requirement)
    VALUES (:id, :name, :description, :points, :completed, :progress, :requirement);
_updateQuest:
    UPDATE [quests]
    SET name = :name, description = :description, points = :points, completed = :completed, progress = :progress, requirement = :requirement
    WHERE id = :id;

CREATE TABLE IF NOT EXISTS [leaderboard] (
    [user_id] TEXT PRIMARY KEY NOT NULL,
    [name] TEXT NOT NULL,
    [points] INTEGER NOT NULL,
    [level] INTEGER NOT NULL
);

_getLeaderboard:
    SELECT * FROM [leaderboard]
    ORDER BY points DESC;
_getLeaderboardEntry:
    SELECT * FROM [leaderboard]
    WHERE user_id = :userId
    LIMIT 1;
_insertLeaderboardEntry:
    INSERT INTO [leaderboard] (user_id, name, points, level)
    VALUES (:userId, :name, :points, :level);
_updateLeaderboardEntry:
    UPDATE [leaderboard]
    SET name = :name, points = :points, level = :level
    WHERE user_id = :userId;

CREATE TABLE IF NOT EXISTS [message_templates] (
    [id] INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    [name] TEXT NOT NULL,
    [content] TEXT NOT NULL,
    [category] TEXT NOT NULL
);

_getMessageTemplates:
    SELECT * FROM [message_templates];
_getMessageTemplateById:
    SELECT * FROM [message_templates]
    WHERE id = :id
    LIMIT 1;
_insertMessageTemplate:
    INSERT INTO [message_templates] (name, content, category)
    VALUES (:name, :content, :category);
_updateMessageTemplate:
    UPDATE [message_templates]
    SET name = :name, content = :content, category = :category
    WHERE id = :id;
_deleteMessageTemplate:
    DELETE FROM [message_templates]
    WHERE id = :id;

CREATE TABLE IF NOT EXISTS [user_settings] (
    [id] INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    [display_name] TEXT NOT NULL,
    [email] TEXT NOT NULL,
    [timezone] TEXT NOT NULL,
    [date_format] TEXT NOT NULL,
    [theme] TEXT NOT NULL,
    [accent_color] INTEGER NOT NULL,
    [message_reminders] INTEGER NOT NULL,
    [birthday_reminders] INTEGER NOT NULL,
    [achievement_notifications] INTEGER NOT NULL,
    [daily_quests] INTEGER NOT NULL,
    [data_encryption] INTEGER NOT NULL,
    [analytics] INTEGER NOT NULL,
    [auto_lock] INTEGER NOT NULL
);

_getUserSettings:
    SELECT * FROM [user_settings]
    LIMIT 1;
_insertUserSettings:
    INSERT INTO [user_settings] (display_name, email, timezone, date_format, theme, accent_color, message_reminders, birthday_reminders, achievement_notifications, daily_quests, data_encryption, analytics, auto_lock)
    VALUES (:displayName, :email, :timezone, :dateFormat, :theme, :accentColor, :messageReminders, :birthdayReminders, :achievementNotifications, :dailyQuests, :dataEncryption, :analytics, :autoLock);
_updateUserSettings:
    UPDATE [user_settings]
    SET display_name = :displayName, email = :email, timezone = :timezone, date_format = :dateFormat, theme = :theme, accent_color = :accentColor, message_reminders = :messageReminders, birthday_reminders = :birthdayReminders, achievement_notifications = :achievementNotifications, daily_quests = :dailyQuests, data_encryption = :dataEncryption, analytics = :analytics, auto_lock = :autoLock
    WHERE id = :id;
